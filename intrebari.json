'[{"Unnamed: 0":1,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Căror nave li se aplică prevederile Colreg-1972?","Răspuns 1":"tuturor navelor care navigă în apele internaționale.","orect":0,"Răspuns 2":"tuturor navelor care navigă în rade, strâmtori și marea liberă.","orect.1":0,"Răspuns 3":"tuturor navelor aflate în largul mării ori\\npe toate apele învecinate accesibile navelor maritime.","orect 3":1},{"Unnamed: 0":2,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Tuturor navelor aflate în largul mării ori pe toate apele învecinate\\naccesibile navelor maritime li se aplică prevederile:","Răspuns 1":"COLREG-1972.","orect":1,"Răspuns 2":"R.N.D.","orect.1":0,"Răspuns 3":"Codului ISPS.","orect 3":0},{"Unnamed: 0":3,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Dispozițiile Regulamentului împiedică aplicarea prescripțiilor speciale stabilite de către autoritatea competentă referitoare la navigația în rade, porturi, pe fluvii, lacuri sau căi de navigaţie interioară accesibile\\nnavelor maritime?","Răspuns 1":"da.","orect":0,"Răspuns 2":"nu.","orect.1":1,"Răspuns 3":"nu este precizat.","orect 3":0},{"Unnamed: 0":4,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum influenţează prevederile Regulamentului prescripţiile speciale referitoare la navigaţia în rade, porturi, pe fluvii, lacuri sau căi de navigaţie interioară accesibile navelor maritime?","Răspuns 1":"dispoziţiile regulamentului nu trebuie să împiedice aplicarea prescripţiilor speciale\\nstabilite de către autoritatea competentă, dar asemenea prescripţii speciale trebuie să fie cât mai conforme cu prezentele\\nreguli.","orect":1,"Răspuns 2":"autoritatea competentă nu este obligată să ţină seama de prescripţiile Regulamentului.","orect.1":0,"Răspuns 3":"în toate situaţiile se vor aplica\\nprevederile Regulamentului.","orect 3":0},{"Unnamed: 0":5,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Guvernul unui stat poate stabili prescripţiile speciale cu privire la numărul luminilor de poziţie, a semnalelor luminoase, prescripţii care să fie astfel încât să facă imposibilă confundarea lor cu Regulamentul?","Răspuns 1":"nu.","orect":0,"Răspuns 2":"nu este precizat.","orect.1":0,"Răspuns 3":"da.","orect 3":1},{"Unnamed: 0":6,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Dispoziţiile Regulamentului scutesc nava, comandantul sau armatorul de consecinţele unei neglijenţe oarecare în ceea ce priveşte aplicarea Regulamentului sau în ceea ce priveşte luarea tuturor măsurilor cerute\\nde o bună practică marinărească?","Răspuns 1":"nu este precizat.","orect":0,"Răspuns 2":"da.","orect.1":0,"Răspuns 3":"nu.","orect 3":1},{"Unnamed: 0":7,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când este exonerată o navă, comanantul sau armatorul de\\nconsecinţele unei neglijenţe sau de neluarea tuturor măsurilor cerute de o bună practică marinărească?","Răspuns 1":"aplicarea regulilor scuteşte nava, comandantul sau armatorul de orice răspundere.","orect":0,"Răspuns 2":"conformarea întocmai la prevederile regulii \\"navă privilegiată\\" scuteşte nava, comandantul sau armatorul de orice răspundere.","orect.1":0,"Răspuns 3":"dispoziţiile Regulamentului nu scutesc nava, comandantul sau armatorul de consecinţele unei neglijenţe oarecare în ceea ce priveşte aplicarea\\nRegulamentului sau în ceea ce priveşte luarea tuturor măsurilor cerute de o bună practică marinărească.","orect 3":1},{"Unnamed: 0":8,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când există riscul unei coliziuni, precum şi în toate împrejurările\\ndeosebite sunt permise:","Răspuns 1":"abaterea de la prevederile\\nRegulamentului.","orect":1,"Răspuns 2":"abateri de la prevederile autorităţilor\\nportuare.","orect.1":0,"Răspuns 3":"abateri de la prevederile legilor\\nspecifice.","orect 3":0},{"Unnamed: 0":9,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când sunt permise abateri de la prevederile Regulamentului?","Răspuns 1":"în apele naţionale, rade şi în toate apele\\nînvecinate accesibile navelor maritime.","orect":0,"Răspuns 2":"când există pericol de navigaţie, riscul unei coliziuni, precum şi în\\ntoate împrejurările deosebite.","orect.1":1,"Răspuns 3":"indiferent de situaţie, nu este permisă\\nabaterea de la prevederile Regulamentului.","orect 3":0},{"Unnamed: 0":10,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia\\"navă\\", conform Regulamentului?","Răspuns 1":"orice construcţie sau aparat, de orice natură, capabil să plutească pe apă fără propulsie.","orect":0,"Răspuns 2":"orice construcţie sau orice aparat, de orice natură ar fi, inclusiv\\nconstrucţiile fără pescaj şi hidro avioane, folosite sau susceptibile de a fi folosite ca mijloc de transport pe\\napă.","orect.1":1,"Răspuns 3":"orice corp plutitor cu orice mijloc de propulsie.","orect 3":0},{"Unnamed: 0":11,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin \\"navă cu propulsie mecanică\\"?","Răspuns 1":"orice navă pusă în mişcare de către o\\nmaşină.","orect":1,"Răspuns 2":"navele care folosesc ca mijloc de\\npropulsie un  motor Diesel.","orect.1":0,"Răspuns 3":"toate navele care se pot  deplasa pe\\napă, cu excepţia navelor cu vele.","orect 3":0},{"Unnamed: 0":12,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"O navă care navigă cu vele, chiar dacă are o maşină proprie, cu condiţia\\nca aceasta să nu fie folosită, reprezintă:","Răspuns 1":"o navă cu vele.","orect":1,"Răspuns 2":"o navă cu propulsie mecanică, care\\nfoloseşte şi velele.","orect.1":0,"Răspuns 3":"o navă care foloseşte ca mijloc de\\npropulsie forţa vântului.","orect 3":0},{"Unnamed: 0":13,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia \\"navă cu vele\\"?","Răspuns 1":"o navă care foloseşte ca mijloc de propulsie forţa vântului.","orect":0,"Răspuns 2":"o navă cu propulsie mecanică, care foloseşte şi vele.","orect.1":0,"Răspuns 3":"o navă care navigă cu vele, chiar dacă are o maşină proprie, cu condiţia ca\\naceasta să nu fie folosită.","orect 3":1},{"Unnamed: 0":14,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"O navă care din cauza unei împrejurări excepţionale nu este în măsură să manevreze şi deci, nu poate să se îndepărteze din drumul altei nave\\ntrebuie considerată:","Răspuns 1":"nava nu este stăpână pe manevra sa.","orect":1,"Răspuns 2":"navă cu capacitate de manevră redusă.","orect.1":0,"Răspuns 3":"navă stânjenită de pescajul său.","orect 3":0},{"Unnamed: 0":15,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia \\"navă cu capacitate de manevră redusă\\"?","Răspuns 1":"o navă a cărei capacitate de manevră conform Regulamentului este limitată prin natura lucrărilor sale şi care, în consecinţă, nu se poate îndepărta din\\ndrumul altei nave.","orect":1,"Răspuns 2":"o navă cu avarii accidentale la cârmă şi/sau maşină, în curs de remediere.","orect.1":0,"Răspuns 3":"o navă care nu se poate abate din drumul său, datorită unor pericole de navigaţie.","orect 3":0},{"Unnamed: 0":16,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"O navă cu propulsie mecanică, care din cauza pescajului şi a adâncimii apei sub chilă poate să-şi modifice cu greu drumul, se consideră :","Răspuns 1":"navă stânjenită de pescajul său.","orect":1,"Răspuns 2":"navă cu lungime mai mare de 200 m","orect.1":0,"Răspuns 3":"navă cu capacitate de manevră redusă.","orect 3":0},{"Unnamed: 0":17,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"O navă care nu este nici la ancoră, nici legată la cheu, nici eşuată se\\nconsideră:","Răspuns 1":"navă \\"în marş\\".","orect":1,"Răspuns 2":"navă în derivă.","orect.1":0,"Răspuns 3":"navă care ţine la capă.","orect 3":0},{"Unnamed: 0":18,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când una dintre nave poate fi observată vizual de către cealaltă navă,\\nse consideră:","Răspuns 1":"navă în siguranţă.","orect":0,"Răspuns 2":"nave aflate în vedere.","orect.1":1,"Răspuns 3":"nave în marş.","orect 3":0},{"Unnamed: 0":19,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când două nave se consideră în vedere?","Răspuns 1":"când se observă  vizual reciproc.","orect":0,"Răspuns 2":"numai când una dintre ele poate fi\\nobservată vizual de către cealaltă.","orect.1":1,"Răspuns 3":"când navele se află în limita de\\nobservare cu radarul.","orect 3":0},{"Unnamed: 0":20,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să se asigure veghea la bordul navei?","Răspuns 1":"trebuie să se asigure în permanenţă o veghe vizuală şi auditivă corespunzătoare, folosind în acelaşi timp toate mijloacele disponibile, potrivit cu împrejurările şi condiţiile existente, în aşa fel încât să\\npermită o apreciere completă a situaţiei.","orect":1,"Răspuns 2":"trebuie să se asigure în permanenţă o veghe vizuală pentru evitarea unei situaţii periculoase.","orect.1":0,"Răspuns 3":"în condiţii de vizibilitate redusă, se va organiza o veghe corespunzătoare, pentru a aprecia existenţa unui pericol de coliziune.","orect 3":0},{"Unnamed: 0":21,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Pentru a se putea acţiona corect şi eficace pentru prevenirea unei coliziuni şi pentru ca nava să poată fi oprită pe o distanţă\\ncorespunzătoare împrejurărilor şi condiţiilor, se impune menţiunea de\\na naviga cu:","Răspuns 1":"viteză maximă.","orect":0,"Răspuns 2":"viteză minimă.","orect.1":0,"Răspuns 3":"viteză de siguranţă.","orect 3":1},{"Unnamed: 0":22,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Care sunt factorii care trebuie luaţi în consideraţie pentru determinarea \\"vitezei de siguranţă\\"?","Răspuns 1":"lungimea navei, calităţile nautice ale navei, puterea maşinii şi vizibilitatea.","orect":0,"Răspuns 2":"pregătirea echipajului, condiţiile de navigaţie, vizibilitatea.","orect.1":0,"Răspuns 3":"vizibilitatea, densitatea traficului,\\ncapacitatea de manevră a navei,\\nnoaptea-existenţa unui fundal luminos, starea vântului şi a mării, pescajul navei.","orect 3":1},{"Unnamed: 0":23,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Orice navă trebuie să folosească toate mijloacele disponibile corespunzătoare împrejurărilor şi condiţiilor externe pentru a stabili\\ndacă există:","Răspuns 1":"un pericol de eşuare.","orect":0,"Răspuns 2":"un pericol iminent.","orect.1":0,"Răspuns 3":"un pericol de coliziune.","orect 3":1},{"Unnamed: 0":24,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce mijloace trebuie să folosească o navă pentru a stabili dacă există\\npericolul de coliziune?","Răspuns 1":"orice navă trebuie să folosească toate mijloacele disponibile corespunzătoare împrejurărilor şi condiţiilor extrene,\\npentru a stabili dacă există un pericol de\\ncoliziune.","orect":1,"Răspuns 2":"orice navă trebuie să folosească toate mijloacele vizuale, pentru a stabili dacă există pericolul de coliziune.","orect.1":0,"Răspuns 3":"orice navă trebuie să folosească radarul, pentru a stabili dacă există pericolul de coliziune.","orect 3":0},{"Unnamed: 0":25,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când relevmentul compas la o navă care se apropie nu variază în mod\\napreciabil, se consideră :","Răspuns 1":"nave în vedere.","orect":0,"Răspuns 2":"pericol de coliziune.","orect.1":1,"Răspuns 3":"nave cu drumuri opuse.","orect 3":0},{"Unnamed: 0":26,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când se consideră că există pericol de coliziune?","Răspuns 1":"când navele navigă în drumuri opuse.","orect":0,"Răspuns 2":"când relevmentul compas la o navă care se apropie nu variază în mod\\napreciabil.","orect.1":1,"Răspuns 3":"când viteza de apropiere între cele\\ndouă nave este foarte mare.","orect 3":0},{"Unnamed: 0":27,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să se execute o manevră pentru evitarea unei coliziuni?","Răspuns 1":"din timp, cu schimbări mici de drum,\\npentru a nu devia prea mult de la drumul\\nnavei.","orect":0,"Răspuns 2":"hotărât, din timp şi conform cu buna practică marinărească.","orect.1":1,"Răspuns 3":"hotărât, cu variaţii de viteză, pentru\\nevitarea pericolului.","orect 3":0},{"Unnamed: 0":28,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să se execute schimbările de drum şi/sau de viteză pentru\\nevitarea ueni coliziuni?","Răspuns 1":"schimbări mici de drum şi/sau de viteză, pentru a nu devia prea mult de la drumul navei.","orect":0,"Răspuns 2":"schimbări destul de mari de viteză şi mici de drum, pentru  a nu devia prea mult de la drumul navei.","orect.1":0,"Răspuns 3":"dacă împrejurările permit, să fie destul de mare, pentru a putea fi percepută\\nimediat de orice navă care o observă\\nvizual sau cu radarul.","orect 3":1},{"Unnamed: 0":29,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Dacă pentru evitarea unei coliziuni este suficientă numai schimbarea de drum, cum trebuie să fie executată?","Răspuns 1":"manevra se va face cu mult timp înainte,\\nsă fie substanţială şi să nu conducă la o altă situaţie de foarte mare apropiere.","orect":1,"Răspuns 2":"se vor executa schimbări mari de\\ndrum, suficiente pentru evitarea coliziunii.","orect.1":0,"Răspuns 3":"se va efectua o schimbare de drum\\nsuficientă pentru ca să se elimine orice\\npericol de coliziune.","orect 3":0},{"Unnamed: 0":30,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Manevra de evitare între nave se va efectua astfel încât să permită\\ntrecerea la:","Răspuns 1":"o distanţă maximă.","orect":0,"Răspuns 2":"o distanţă de siguranţă.","orect.1":1,"Răspuns 3":"o distanţă minimă.","orect 3":0},{"Unnamed: 0":31,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Până când se controlează eficacitatea unei manevre de evitare?","Răspuns 1":"până când navele vor fi la travers una faţă\\nde cealaltă.","orect":0,"Răspuns 2":"până când nava cealaltă va fi într-un\\nunghi de 45° tribord/babord.","orect.1":0,"Răspuns 3":"până când nava cealaltă a fost complet\\nşi definitiv depăşită.","orect 3":1},{"Unnamed: 0":32,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Care este manevra cea mai indicată pentru a se câştiga mai mult timp pentru aprecierea situaţiei, atunci când trebuie să se evite o coliziune?","Răspuns 1":"reducerea vitezei sau opirea completă, stopând maşinile ori punându-le înapoi.","orect":1,"Răspuns 2":"stoparea navei.","orect.1":0,"Răspuns 3":"reducerea la minimum de viteză, până la limita guvernării.","orect 3":0},{"Unnamed: 0":33,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum se navigă în şenal sau cale navigabilă îngustă?","Răspuns 1":"pe mijlocul şenalului sau căii de acces.","orect":0,"Răspuns 2":"cât mai aproape posibil de marginea exterioară din dreapta şenalului sau căii de acces respective, atunci când aceasta se poate face.","orect.1":1,"Răspuns 3":"se va naviga întotdeauna cât mai aproape posibil de marginea exterioară a şenalului sau căii de acces, pentru asigurarea unei veghe\\ncorespunzătoare.","orect 3":0},{"Unnamed: 0":34,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce semnale pot da navele care navigă prin şenal şi se îndoiesc de\\nintenţiile navei care traversează şenalul?","Răspuns 1":"un sunet lung şi două scurte.","orect":0,"Răspuns 2":"un semnal de avertizare compus din\\ncinci sunete scurte.","orect.1":1,"Răspuns 3":"un semnal lung de atenţionare.","orect 3":0},{"Unnamed: 0":35,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce măsuri de siguranţă trebuie să ia o navă care se apropie de un cot aflat într-un şenal sau o cale de acces îngustă?","Răspuns 1":"să emită cinci sunete scurte (de\\navertizare)","orect":0,"Răspuns 2":"să emită un semnal scurt şi să navige pe partea dreaptă a şenalului.","orect.1":0,"Răspuns 3":"să emită un semnal lung şi să navige cu prudenţă şi vigilenţă.","orect 3":1},{"Unnamed: 0":36,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Schemelor de separare a traficului li se aplică reglementările\\nreferitoare la schemele de separare a traficului, adoptate de:","Răspuns 1":"guvernele ţărilor unde se află schemele.","orect":0,"Răspuns 2":"Organizaţie.","orect.1":1,"Răspuns 3":"Organizaţie şi guvernele anumitor ţări.","orect 3":0},{"Unnamed: 0":37,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Nava trebuie să navige pe banda de navigaţie corespunzătoare în direcţia generală a traficului şi să se îndepărteze,în măsura posibilului, de linia  sau zona de separare a sensurilor de trafic atunci când trebuie\\nsă navige:","Răspuns 1":"în exteriorul unei scheme de separare a traficului.","orect":0,"Răspuns 2":"în interiorul unei scheme de separare a traficului.","orect.1":1,"Răspuns 3":"în interiorul unei benzi de separaţie.","orect 3":0},{"Unnamed: 0":38,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să se angajeze o navă pentru intrarea sau ieşirea dintr-o schemă de separare a traficului?","Răspuns 1":"sub un unghi drept faţă de direcţia generală a traficului.","orect":0,"Răspuns 2":"ca regulă generală pe la una din extremităţi,dar atunci când se angajează să intre sau să iasă,din orice parte,să facă manevra sub unghi cât mai mic faţă de direcţia\\ntraficului.","orect.1":1,"Răspuns 3":"prin zona de separare a traficului,dar cu\\naprobarea autorităţilor care\\nsupraveghează navigaţia în schema de\\nseparare a traficului.","orect 3":0},{"Unnamed: 0":39,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să întretaie o navă benzile de separaţie, când este obligată să o facă?","Răspuns 1":"sub un unghi cât mai mic faţă de direcţia generală a traficului şi cu viteza redusă.","orect":0,"Răspuns 2":"sub un unghi cât mai mic faţă de direcţia generală a traficului şi cu\\nviteză maximă.","orect.1":0,"Răspuns 3":"pe cât posibil perpendicular faţă de direcţia generală a traficului.","orect 3":1},{"Unnamed: 0":40,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Zonele de navigaţie costieră pot fi folosite pentru traficul costier?","Răspuns 1":"în mod normal nu trebuie folosite pentru\\ntraficul direct, cu excepţia navelor mai\\nmici de 20 m lungime şi a navelor cu vele.","orect":1,"Răspuns 2":"pot fi folosite de toate navele\\naparţinând ţării riverane.","orect.1":0,"Răspuns 3":"pot fi folosite de navele cu capacitate\\nde manevră redusă.","orect 3":0},{"Unnamed: 0":41,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când poate o navă să pătrundă într-o zonă de separare sau să taie o\\nlinie de separare?","Răspuns 1":"când condiţiile hidrometeorologice fac dificilă navigaţia în sensul general al\\ntraficului.","orect":0,"Răspuns 2":"în caz de urgenţă, pentru evitarea\\nunui pericol imediat, sau pentru a\\npescui într-o zonă de separare.","orect.1":1,"Răspuns 3":"zona de separare nu va fi traversată în nici o situaţie.","orect 3":0},{"Unnamed: 0":42,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să se navige în zone vecine cu extremităţile unei zone de\\nseparare a traficului?","Răspuns 1":"se va naviga în direcţia generală a\\ntraficului.","orect":0,"Răspuns 2":"se vor semnaliza sonor şi vizual\\nintenţiile de schimbare de drum.","orect.1":0,"Răspuns 3":"cu atenţie deosebită.","orect 3":1},{"Unnamed: 0":43,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Este permisă ancorarea în schemele de separare a traficului?","Răspuns 1":"se va evita în măsura maximă a posibilului ancorarea atât în schema de separare, cât şi în zonele învecinate acesteia.","orect":1,"Răspuns 2":"se poate ancora, dar se vor da toate semnalele prevăzute în prezentele reguli.","orect.1":0,"Răspuns 3":"nu se poate ancora în nici o situaţie.","orect 3":0},{"Unnamed: 0":44,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să navige navele care nu folosesc o schemă de separare a\\ntraficului?","Răspuns 1":"să folosească zonele de navigaţie costieră.","orect":0,"Răspuns 2":"să se îndepărteze cât mai mult de\\nzona de separare a traficului.","orect.1":1,"Răspuns 3":"să navige în apropiere, dar să nu\\nintersecteze linia de separare.","orect 3":0},{"Unnamed: 0":45,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Care sunt navele exceptate de la  prevederile regulii referitoare la\\nnavigaţie în schemele de separare a traficului?","Răspuns 1":"navele cu capacitate de manevră redusă, angajate în manevra de menţinere a\\nsiguranţei navigaţiei.","orect":1,"Răspuns 2":"navele cu defecţiuni la motorul\\nprincipal.","orect.1":0,"Răspuns 3":"navele cu avarii la cârmă.","orect 3":0},{"Unnamed: 0":46,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce navă trebuie să se abată din drumul navei  ajunsă  din urmă?","Răspuns 1":"nava care se află la o distanţă de 200 m.","orect":0,"Răspuns 2":"nava care se află la o distanţă de 100\\nm.","orect.1":0,"Răspuns 3":"nava care ajunge din urmă.","orect 3":1},{"Unnamed: 0":47,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum se comportă o navă care ajunge din urmă (depăşeşte) o altă navă?","Răspuns 1":"nava care ajunge din urmă o altă navă va\\navea prioritate.","orect":0,"Răspuns 2":"nava ajunsă din urmă va manevra\\nastfel încât să-i permită navei care o depăşeşte deplasarea.","orect.1":0,"Răspuns 3":"orice navă care ajunge din urmă o altă\\nnavă trebuie să se abată din drumul navei ajunsă din urmă.","orect 3":1},{"Unnamed: 0":48,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când se consideră că o navă ajunge din urmă altă navă?","Răspuns 1":"când vine dintr-o direcţie mai mare de 22°5 dinapoia traversului celeilalte nave, astfel încât noaptea se vede numai lumina din pupa şi luminile din bordurile navei\\najunsă din urmă.","orect":1,"Răspuns 2":"când vede lumina din pupa şi luminile din bordurile navei ajunsă din urmă.","orect.1":0,"Răspuns 3":"când vede lumina catargului pupa şi\\nluminile din pupa.","orect 3":0},{"Unnamed: 0":49,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să manevreze o navă care nu poate stabili cu siguranţă că ajunge din urmă altă navă?","Răspuns 1":"să se considere navă privilegiată şi şă-şi menţină viteza şi drumul.","orect":0,"Răspuns 2":"să se considere navă care ajunge din urmă şi să manevreze în consecinţă.","orect.1":1,"Răspuns 3":"să dea semnalele corespunzătoare şi după edificare să procedeze conform\\nsituaţiei.","orect 3":0},{"Unnamed: 0":50,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să manevreze două nave cu vele care se apropie una de alta, astfel încât există pericolul de coliziune şi primesc vântul din borduri diferite?","Răspuns 1":"nava care primeşte vântul din babord trebuie să se abată din drumul navei care primeşte vântul din tribord.","orect":1,"Răspuns 2":"nava care primeşte vântul din tribord trebuie să se abată din drumul navei care primeşte vântul din babord.","orect.1":0,"Răspuns 3":"nava care primeşte vântul din pupa trebuie să se abată din drumul navei care primeşte vântul din tribord.","orect 3":0},{"Unnamed: 0":51,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cum trebuie să manevreze două nave cu vele care se apropie una de alta, astfel încât există pericolul de coliziune şi primesc vântul din\\nacelaşi bord?","Răspuns 1":"nava care o vede pe cealaltă prin babord trebuie să se abată din drumul celeilalte\\nnave.","orect":0,"Răspuns 2":"nava care este în vânt se va abate din drumul navei de sub vânt.","orect.1":1,"Răspuns 3":"nava care o vede pe cealaltă prin tribord trebuie să se abată din drumul\\nceleilalte nave.","orect 3":0},{"Unnamed: 0":52,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Care este manevra unei nave care nu este obligată să se abată din\\ndrumul altei nave?","Răspuns 1":"trebuie să-şi menţină drumul şi viteza.","orect":1,"Răspuns 2":"va schimba numai drumul, pentru a\\nevita o situaţie periculoasă.","orect.1":0,"Răspuns 3":"va reduce viteza sau va stopa, pentru a\\nnu crea situaţii periculoase.","orect 3":0},{"Unnamed: 0":53,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când trebuie să manevreze nava care nu este obligată să se abată din\\ndrumul altei nave?","Răspuns 1":"indiferent de situaţie, nu se va abate niciodată din drumul altei nave.","orect":0,"Răspuns 2":"imediat ce i se pare evident faptul că nava care are obligaţia de a se abate din drumul său nu face manevra.","orect.1":1,"Răspuns 3":"când în urma observării relevmentului şi-a dat seama că există pericolul de coliziune.","orect 3":0},{"Unnamed: 0":54,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Din drumul căror nave trebuie să se abată o navă cu propulsie\\nmecanică în marş?","Răspuns 1":"navelor cu vele.","orect":1,"Răspuns 2":"velierelor care navigă numai cu\\nmaşina.","orect.1":0,"Răspuns 3":"velierelor care poartă la prova un semn\\nconic negru, cu vârful în jos.","orect 3":0},{"Unnamed: 0":55,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Din drumul căror nave trebuie să se abată o navă cu vele în marş?","Răspuns 1":"navelor cu propulsie mecanică cu viteză\\nmică.","orect":0,"Răspuns 2":"navelor care nu sunt stăpâne pe\\nmanevra lor.","orect.1":1,"Răspuns 3":"navelor petroliere sau navelor care\\ntransportă gaze lichefiate.","orect 3":0},{"Unnamed: 0":56,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Din drumul căror nave trebuie să se abată o navă cu vele în marş?","Răspuns 1":"navelor frigorifice cu viteză mare.","orect":0,"Răspuns 2":"navelor petroliere.","orect.1":0,"Răspuns 3":"navelor cu capacitate de manevră\\nredusă.","orect 3":1},{"Unnamed: 0":57,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Din drumul căror nave trebuie să se abată o navă cu vele în marş?","Răspuns 1":"navelor în curs de pescuit.","orect":1,"Răspuns 2":"traulelor aflate în marş spre zona de\\npescuit.","orect.1":0,"Răspuns 3":"navelor colectoare de peşte  aflate în\\nmarş.","orect 3":0},{"Unnamed: 0":58,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Din drumul căror nave trebuie să se abată o navă stânjenită de pescajul\\nsău?","Răspuns 1":"navelor cu vele.","orect":0,"Răspuns 2":"navelor nestăpâne pe manevra lor.","orect.1":1,"Răspuns 3":"navelor petrolier sau navelor care\\ntransportă gaze lichefiate.","orect 3":0},{"Unnamed: 0":59,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Căror nave li se aplică regulile de conducerea navelor pe vizibilitate redusă?","Răspuns 1":"navelor care navigă în interiorul zonelor de vizibiliate redusă şi numai una dintre ele nu o vede pe cealaltă.","orect":0,"Răspuns 2":"navelor care nu se văd una pe alta şi care navigă înlăuntrul sau în apropierea zonelor de vizibilitate\\nredusă.","orect.1":1,"Răspuns 3":"navelor care navigă în interiorul sau în apropierea zonelor de vizibilitate redusă şi observă una la alta numai\\nluminile de catarg.","orect 3":0},{"Unnamed: 0":60,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Cu ce viteză trebuie să navige o navă în condiţii de vizibilitate redusă?","Răspuns 1":"cu viteză redusă şi veghe la prova.","orect":0,"Răspuns 2":"cu viteză economică, dar cu radarul în funcţiune şi cu o veghe corespunzătoare, pentru a evita\\npericolul de coliziune.","orect.1":0,"Răspuns 3":"cu o viteză de siguranţă adaptată\\nîmprejurărilor existente şi condiţiilor de vizibilitate redusă.","orect 3":1},{"Unnamed: 0":61,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când se vor respecta regulile referitoare la \\"lumini şi semne\\"?","Răspuns 1":"în marş ziua şi noaptea.","orect":0,"Răspuns 2":"pe orice vreme.","orect.1":1,"Răspuns 3":"în staţionare ziua şi noaptea.","orect 3":0},{"Unnamed: 0":62,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"În ce perioadă sunt respectate regulile referitoare la lumini?","Răspuns 1":"pe timpul nopţii.","orect":0,"Răspuns 2":"pe timpul nopţii şi pe vizibilitate\\nredusă.","orect.1":0,"Răspuns 3":"de la apusul la răsăritul  soarelui.","orect 3":1},{"Unnamed: 0":63,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Pe timpul zilei se vor respecta regulile cu privire la:","Răspuns 1":"lumini.","orect":0,"Răspuns 2":"semne.","orect.1":1,"Răspuns 3":"lumini şi semne.","orect 3":0},{"Unnamed: 0":64,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când mai pot fi purtate luminile prevăzute de reguli?","Răspuns 1":"de la răsăritul la apusul soarelui, pe timp cu vizibilitate redusă, în toate\\nîmprejurările în care această măsură este\\nnecesară.","orect":1,"Răspuns 2":"când vizibilitatea este sub 3 Mm.","orect.1":0,"Răspuns 3":"în srâmtori, când vizibiliatea este\\nredusă.","orect 3":0},{"Unnamed: 0":65,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Când se vor respecta regulile referitoare la semne?","Răspuns 1":"în timpul crepusculului.","orect":0,"Răspuns 2":"pe timpul zilei.","orect.1":1,"Răspuns 3":"ziua sau noaptea, când sunt iluminate.","orect 3":0},{"Unnamed: 0":66,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Lumina albă aşezată deasupra axului longitudinal al navei, arătând o lumină neîntreruptă pe un arc de orizont de 22°5 astfel ca să arate\\n22°5 înapoia traversului fiecărui bord este:","Răspuns 1":"lumina de pupa.","orect":0,"Răspuns 2":"lumina de catarg.","orect.1":1,"Răspuns 3":"lumina de remorcaj.","orect 3":0},{"Unnamed: 0":67,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Lumină verde din tribord şi lumină roşie din babord, vizibile pe un arc de 112°5 adică de la prova până la 22°5 înapoia traversului, reprezintă\\nceea ce se înţelege prin expresia:","Răspuns 1":"lumină de bord.","orect":1,"Răspuns 2":"lumină de pupa.","orect.1":0,"Răspuns 3":"lumină de remorcaj.","orect 3":0},{"Unnamed: 0":68,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia \\"lumină de catarg\\"?","Răspuns 1":"orice lumină albă instalată pe catargul unei nave la o înălţime prevăzută de normele din registru.","orect":0,"Răspuns 2":"orice lumină albă vizibilă pe tot\\norizontul.","orect.1":0,"Răspuns 3":"o lumină albă aşezată deasupra axului longitudinal al navei, arătând o lumină neîntreruptă pe un arc de orizont de 225°, astfel ca să arate 22°5 înapoia\\ntraversului fiecărui bord.","orect 3":1},{"Unnamed: 0":69,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia \\"lumină de bord\\"?","Răspuns 1":"lumină verde din tribord şi lumină roşie din babord, vizibile pe un arc de 112°5, adică la prova până la 22°5 înapoia\\ntraversului.","orect":1,"Răspuns 2":"lumină albă din borduri, de la scările\\nde acces.","orect.1":0,"Răspuns 3":"lumină albă de la scările exterioare.","orect 3":0},{"Unnamed: 0":70,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Lumina albă aşezată cât mai aproape posibil în pupa, arătând o lumină\\nneîntreruptă pe un arc de 135° câte 67°5 în fieare bord este:","Răspuns 1":"lumina de ancoră pupa.","orect":0,"Răspuns 2":"lumina de remorcaj.","orect.1":0,"Răspuns 3":"lumina de pupa.","orect 3":1},{"Unnamed: 0":71,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Ce se înţelege prin expresia \\"lumină de pupa\\"?","Răspuns 1":"o lumină albă instalată la pupa unei nave.","orect":0,"Răspuns 2":"o lumină aşezată cât mai aproape posibil în pupa, arătând o lumină neîntreruptă pe un arc de 135°, câte\\n67°5 în fiecare bord.","orect.1":1,"Răspuns 3":"o lumină albă instalată la pupa, care arată ca o lumină întreruptă pe un arc de cerc de 135°, câte 67°5 în fiecare\\nbord.","orect 3":0},{"Unnamed: 0":72,"Unnamed: 1":"","Unnamed: 2":"","Unnamed: 3":"","Întrebare":"Lumina galbenă aşezată cât mai aproape posibil în pupa arătând o\\nlumină de 135°, câte 67°5 în fiecare bord este:","Răspuns 1":"lumina de pupa.","orect":0,"Răspuns 2":"lumina de remorcaj.","orect.1":1,"Răspuns 3":"lumina de ancoră pupa.","orect 3":0},{"Unnamed: 0":7