{
  "name": "caa-quiz",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_ROUTER_APP_ROOT=./app EXPO_PUBLIC_USE_TEST_ADS=true expo start",
    "android": "EXPO_ROUTER_APP_ROOT=./app EXPO_PUBLIC_USE_TEST_ADS=true expo run:android",
    "ios": "EXPO_ROUTER_APP_ROOT=./app EXPO_PUBLIC_USE_TEST_ADS=true expo run:ios",
    "web": "expo start --web",
    "build:preview": "EXPO_ROUTER_APP_ROOT=./app EXPO_PUBLIC_USE_TEST_ADS=true eas build --platform android --profile preview --local --output build/preview.apk && ./scripts/save-build.sh preview",
    "build:production": "EXPO_ROUTER_APP_ROOT=./app eas build --platform android --profile production --local --output build/production.aab && ./scripts/save-build.sh production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.101.1",
    "expo": "^55.0.10-canary-20260328-2049187",
    "expo-constants": "55.0.10-canary-20260328-2049187",
    "expo-linking": "55.0.10-canary-20260328-2049187",
    "expo-notifications": "55.0.15-canary-20260328-2049187",
    "expo-router": "55.0.9-canary-20260328-2049187",
    "expo-status-bar": "55.0.5-canary-20260328-2049187",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-google-mobile-ads": {
      "expo": "$expo"
    }
  },
  "private": true
}
